<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
	http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
	name="ExamListReport"
	pageWidth="842"
	pageHeight="595"
	orientation="Landscape"
	columnWidth="782"
	leftMargin="30"
	rightMargin="30"
	topMargin="20"
	bottomMargin="20">

	<field name="id" class="java.lang.Long"/>
	<field name="examName" class="java.lang.String"/>
	<field name="examDate" class="java.util.Date"/>
	<field name="totalMarks" class="java.lang.Integer"/>
	<field name="passingMarks" class="java.lang.Integer"/>

	<!-- ================= Title ================= -->

	<title>
		<band height="55">

			<rectangle>
				<reportElement x="0" y="0" width="782" height="46"
					backcolor="#1565C0" forecolor="#1565C0"/>
				<graphicElement>
					<pen lineWidth="0.0"/>
				</graphicElement>
			</rectangle>

			<staticText>
				<reportElement x="0" y="4" width="782" height="38"
					forecolor="#FFFFFF"/>

				<textElement textAlignment="Center"
					verticalAlignment="Middle">
					<font size="16" isBold="true"/>
				</textElement>

				<text><![CDATA[Exam List Report]]></text>

			</staticText>

		</band>
	</title>

	<!-- ================= Page Header ================= -->

	<pageHeader>

		<band height="18">

			<staticText>
				<reportElement x="0" y="0" width="391" height="18"
					forecolor="#666666"/>
				<textElement verticalAlignment="Middle">
					<font size="8"/>
				</textElement>
				<text><![CDATA[Online Result System]]></text>
			</staticText>

			<textField pattern="dd-MM-yyyy HH:mm">

				<reportElement x="391" y="0" width="391" height="18"
					forecolor="#666666"/>

				<textElement textAlignment="Right"
					verticalAlignment="Middle">
					<font size="8"/>
				</textElement>

				<textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>

			</textField>

		</band>

	</pageHeader>

	<!-- ================= Column Header ================= -->

	<columnHeader>

		<band height="26">

			<rectangle>

				<reportElement x="0" y="0" width="782" height="26"
					backcolor="#0D2137" forecolor="#0D2137"/>

				<graphicElement>
					<pen lineWidth="0.0"/>
				</graphicElement>

			</rectangle>

			<staticText>
				<reportElement x="0" y="0" width="40" height="26"
					forecolor="#FFFFFF"/>
				<textElement textAlignment="Center"
					verticalAlignment="Middle">
					<font size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[#]]></text>
			</staticText>

			<staticText>
				<reportElement x="40" y="0" width="70" height="26"
					forecolor="#FFFFFF"/>
				<textElement textAlignment="Center"
					verticalAlignment="Middle">
					<font size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[ID]]></text>
			</staticText>

			<staticText>
				<reportElement x="110" y="0" width="270" height="26"
					forecolor="#FFFFFF"/>
				<textElement verticalAlignment="Middle">
					<font size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[Exam Name]]></text>
			</staticText>

			<staticText>
				<reportElement x="380" y="0" width="120" height="26"
					forecolor="#FFFFFF"/>
				<textElement verticalAlignment="Middle">
					<font size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[Exam Date]]></text>
			</staticText>

			<staticText>
				<reportElement x="500" y="0" width="140" height="26"
					forecolor="#FFFFFF"/>
				<textElement textAlignment="Center"
					verticalAlignment="Middle">
					<font size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[Total Marks]]></text>
			</staticText>

			<staticText>
				<reportElement x="640" y="0" width="142" height="26"
					forecolor="#FFFFFF"/>
				<textElement textAlignment="Center"
					verticalAlignment="Middle">
					<font size="8" isBold="true"/>
				</textElement>
				<text><![CDATA[Passing Marks]]></text>
			</staticText>

		</band>

	</columnHeader>

	<!-- ================= Detail ================= -->

	<detail>

		<band height="22">

			<rectangle>

				<reportElement x="0" y="0" width="782" height="22"
					backcolor="#EEF2F7">

					<printWhenExpression><![CDATA[$V{REPORT_COUNT}%2==0]]></printWhenExpression>

				</reportElement>

				<graphicElement>
					<pen lineWidth="0.0"/>
				</graphicElement>

			</rectangle>

			<textField>

				<reportElement x="0" y="0" width="40" height="22"
					forecolor="#888888"/>

				<textElement textAlignment="Center"
					verticalAlignment="Middle">
					<font size="8"/>
				</textElement>

				<textFieldExpression><![CDATA[$V{REPORT_COUNT}]]></textFieldExpression>

			</textField>

			<textField>

				<reportElement x="40" y="0" width="70" height="22"/>

				<textElement textAlignment="Center"
					verticalAlignment="Middle">
					<font size="8"/>
				</textElement>

				<textFieldExpression><![CDATA[$F{id}]]></textFieldExpression>

			</textField>

			<textField isBlankWhenNull="true">

				<reportElement x="110" y="0" width="270" height="22"/>

				<textElement verticalAlignment="Middle">
					<font size="8" isBold="true"/>
				</textElement>

				<textFieldExpression><![CDATA[$F{examName}]]></textFieldExpression>

			</textField>

			<textField pattern="dd-MM-yyyy">

				<reportElement x="380" y="0" width="120" height="22"
					forecolor="#1565C0"/>

				<textElement verticalAlignment="Middle">
					<font size="8"/>
				</textElement>

				<textFieldExpression><![CDATA[$F{examDate}]]></textFieldExpression>

			</textField>

			<textField>

				<reportElement x="500" y="0" width="140" height="22"/>

				<textElement textAlignment="Center"
					verticalAlignment="Middle">
					<font size="8"/>
				</textElement>

				<textFieldExpression><![CDATA[$F{totalMarks}]]></textFieldExpression>

			</textField>

			<textField>

				<reportElement x="640" y="0" width="142" height="22"/>

				<textElement textAlignment="Center"
					verticalAlignment="Middle">
					<font size="8"/>
				</textElement>

				<textFieldExpression><![CDATA[$F{passingMarks}]]></textFieldExpression>

			</textField>

		</band>

	</detail>

	<!-- ================= Footer ================= -->

	<pageFooter>

		<band height="20">

			<line>
				<reportElement x="0" y="0" width="782" height="1"
					forecolor="#CCCCCC"/>
			</line>

			<staticText>

				<reportElement x="0" y="3" width="391" height="16"
					forecolor="#888888"/>

				<textElement>
					<font size="8"/>
				</textElement>

				<text><![CDATA[Online Result System - Exam List Report]]></text>

			</staticText>

			<textField>

				<reportElement x="391" y="3" width="391" height="16"
					forecolor="#888888"/>

				<textElement textAlignment="Right">
					<font size="8"/>
				</textElement>

				<textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>

			</textField>

		</band>

	</pageFooter>

	<!-- ================= Summary ================= -->

	<summary>

		<band height="30">

			<line>
				<reportElement x="0" y="4" width="782" height="1"
					forecolor="#CCCCCC"/>
			</line>

			<textField>

				<reportElement x="0" y="10" width="350" height="18"
					forecolor="#1565C0"/>

				<textElement>
					<font size="9" isBold="true"/>
				</textElement>

				<textFieldExpression><![CDATA["Total Exams : " + $V{REPORT_COUNT}]]></textFieldExpression>

			</textField>

		</band>

	</summary>

</jasperReport>